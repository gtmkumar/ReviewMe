# NextAuth.js
NEXTAUTH_SECRET=d8686ce428bfec65dff5e24f5e4336626a4dfec4ca8ffcd4a176b8f7d39b687a
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional - can be set later)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub API (Optional - for integration features)
GITHUB_TOKEN=your-github-personal-access-token

# LinkedIn API (Optional - when available)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# File Upload
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,doc

# Email Service (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (Optional - for caching and background jobs)
REDIS_URL=redis://localhost:6379

# Webhook secrets (Optional - for GitHub integration)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=your-openai-api-key

# Environment
NODE_ENV=development